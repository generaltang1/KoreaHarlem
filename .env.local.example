# Supabase (https://supabase.com/dashboard)
# Project Settings > API 에서 확인할 수 있습니다.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 서버 전용 (선택) — 서비스 롤 키는 절대 클라이언트에 노출하지 마세요
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Toss Payments (https://developers.tosspayments.com)
# KRW MID (국내 카드)
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_...
TOSS_SECRET_KEY=test_sk_...

# 웹훅 URL (개발자센터 > 웹훅 등록, 테스트/라이브 각각)
# https://korea-harlem.vercel.app/api/payments/toss/webhook
# 이벤트: PAYMENT_STATUS_CHANGED, CANCEL_STATUS_CHANGED

# 외화결제 MID (해외카드 USD/JPY + PayPal) — 없으면 CLIENT/SECRET_KEY로 폴백
# NEXT_PUBLIC_TOSS_FOREIGN_CLIENT_KEY=test_ck_...
# TOSS_FOREIGN_SECRET_KEY=test_sk_...
